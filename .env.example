# ==============================================================================
# Lectura — Environment Variables Configuration
# Copy this file to .env and configure your keys
# ==============================================================================

# Gemini AI API Key (Get a free key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# Public Application URL (Used for API calls, media streaming, and self-referential links)
# Default for local development: http://localhost:3000
APP_URL=http://localhost:3000

# Server listening port (default: 3000)
PORT=3000

# Storage data directory (default: ./data)
DATA_DIR=./data
