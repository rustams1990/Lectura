rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/lessons/{lessonId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/lessons/{lessonId}/images/{imageId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/lingqs/{wordId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/wordLinks/{wordId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/lessonTypes/{typeId} {
      allow read, write: if isOwner(userId);
    }
  }
}
