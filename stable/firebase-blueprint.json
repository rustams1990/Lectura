{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores user statistics and global settings",
      "type": "object",
      "properties": {
        "listeningSeconds": { "type": "number", "description": "Total listening seconds tracked" },
        "updatedAt": { "type": "number", "description": "Last updated epoch timestamp" }
      },
      "required": ["listeningSeconds", "updatedAt"]
    },
    "UserLesson": {
      "title": "UserLesson",
      "description": "Custom or synchronized lesson data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "audioUrl": { "type": "string" },
        "audioBase64": { "type": "string" },
        "targetLanguage": { "type": "string" },
        "translationLanguage": { "type": "string" },
        "isBuiltIn": { "type": "boolean" },
        "isArchived": { "type": "boolean" },
        "coverUrl": { "type": "string" },
        "youtubeId": { "type": "string" },
        "lessonType": { "type": "string" }
      },
      "required": ["id", "title", "text", "targetLanguage", "translationLanguage"]
    },
    "UserLingQ": {
      "title": "UserLingQ",
      "description": "Saves words, translations, and learning levels",
      "type": "object",
      "properties": {
        "word": { "type": "string" },
        "translation": { "type": "string" },
        "ipa": { "type": "string" },
        "grammar": { "type": "string" },
        "contextRelation": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "1", "2", "3", "4", "5", "known", "ignored"] },
        "createdAt": { "type": "number" },
        "tags": { "type": "array" }
      },
      "required": ["word", "translation", "status", "createdAt"]
    },
    "UserWordLink": {
      "title": "UserWordLink",
      "description": "Word links or root form mappings",
      "type": "object",
      "properties": {
        "sourceWord": { "type": "string" },
        "targetWord": { "type": "string" }
      },
      "required": ["sourceWord", "targetWord"]
    },
    "UserLessonType": {
      "title": "UserLessonType",
      "description": "Custom lesson types created by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" }
      },
      "required": ["id", "name", "icon"]
    },
    "UserLessonImage": {
      "title": "UserLessonImage",
      "description": "Stores inline images for a custom lesson to bypass the 1MB document limit",
      "type": "object",
      "properties": {
        "dataUrl": { "type": "string" },
        "width": { "type": "string" },
        "height": { "type": "string" }
      },
      "required": ["dataUrl"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user's global profile and sync stats"
    },
    "/users/{userId}/lessons/{lessonId}": {
      "schema": "UserLesson",
      "description": "Synchronized lessons collection"
    },
    "/users/{userId}/lessons/{lessonId}/images/{imageId}": {
      "schema": "UserLessonImage",
      "description": "Stores inline images for a custom lesson"
    },
    "/users/{userId}/lingqs/{wordId}": {
      "schema": "UserLingQ",
      "description": "Saves words that user has encountered or is learning"
    },
    "/users/{userId}/wordLinks/{wordId}": {
      "schema": "UserWordLink",
      "description": "Stores morphological word alignments"
    },
    "/users/{userId}/lessonTypes/{typeId}": {
      "schema": "UserLessonType",
      "description": "User custom lesson types"
    }
  }
}
